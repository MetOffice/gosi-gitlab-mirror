if ! grep -qi xios <<< $(module list); then
  module purge
  module use /home/ar0s/modules
  # may25
  module load prgenv/gnu gcc/may25 hpcx-openmpi/may25 hdf5-parallel/may25 netcdf4-parallel/may25 oasis3-mct/5.0_gcc-xmpi.may25 xios/trunk/r2752_oasis_gcc-xmpi.may25 &> /dev/null
  if ! grep -qi xios <<< $(module list); then echo 'module error'; exit 1; fi
else
  echo 'xios module already loaded'
fi
module list
