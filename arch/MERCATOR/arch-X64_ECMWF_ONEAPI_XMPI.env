  module load prgenv/intel-llvm intel/2025.0.1 hpcx-openmpi/2.18.1 hdf5-parallel/1.14.6 netcdf4-parallel/4.9.3 xios/trunk/r2515_oneapi2025-xmpi 1> /dev/null
