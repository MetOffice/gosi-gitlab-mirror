if ! grep -qi xios <<< $(module list); then
  module purge
  module use /home/ar0s/modules
  # may23
  module load prgenv/intel intel/2021.4.0 openmpi/4.1.1.1 hdf5-parallel/may23 netcdf4-parallel/may23 oasis3-mct/5.0_intel-ompi.may23 xios/trunk/r2752_oasis_intel-ompi.may23 &> /dev/null
  if ! grep -qi xios <<< $(module list); then echo 'module error'; exit 1; fi
else
  echo 'xios module already loaded'
fi
module list
