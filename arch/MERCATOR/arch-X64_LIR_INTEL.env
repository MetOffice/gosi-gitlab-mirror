if ! grep -qi xios <<< $(module list 2>&1); then
  module reset
  module use /home/sparonuzzi/spack/share/spack/modules/linux-rocky9-zen4
  module use /home/gsamson/modules
  module load intel/2024.2.1/tbb/latest intel/2024.2.1/compiler-rt/latest intel/2024.2.1/compiler/2024.2.1 intel/2024.2.1/mpi/2021.13 hdf5/1.14.5-oneapi-2024.2.1 netcdf-c/4.9.2-oneapi-2024.2.1 netcdf-fortran/4.6.1-oneapi-2024.2.1 xios/xios2-trunk/r2752_INTEL &> /dev/null
  module list
  if ! grep -qi xios <<< $(module list 2>&1); then echo 'module error'; exit 1; fi
  source /softs/intel/oneapi/2024.2.1/setvars.sh
  export NETCDF_C_prefix=/home/sparonuzzi/spack/opt/spack/linux-rocky9-zen4/oneapi-2024.2.1/netcdf-c-4.9.2-zzxoahijqyqaiqe753o4cm2cxwpxvdph
  export NETCDF_F_prefix=/home/sparonuzzi/spack/opt/spack/linux-rocky9-zen4/oneapi-2024.2.1/netcdf-fortran-4.6.1-yr7ofxjm5kyh34yheobspsr4yutvgepn
  export HDF5_prefix=/home/sparonuzzi/spack/opt/spack/linux-rocky9-zen4/oneapi-2024.2.1/hdf5-1.14.5-d6bwisnxjhwaxrgvcnpcqyybyd4bc6cw
else
  echo 'xios module already loaded'
fi
